{
  "name": "tabby-grouper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Group related Chrome tabs with AI",
  "license": "MIT",
  "author": "Paul Lin <paul.yy.lin@gmail.com>",
  "homepage": "https://github.com/PaulYYLin/Tabby-Grouper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulYYLin/Tabby-Grouper.git"
  },
  "bugs": {
    "url": "https://github.com/PaulYYLin/Tabby-Grouper/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:icons": "node scripts/generate-icons.mjs",
    "zip": "cd dist && zip -r ../tabby-grouper.zip . -x '*.map' '*.DS_Store'",
    "pack": "npm run build && npm run zip"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@types/chrome": "^0.0.268",
    "sharp": "^0.34.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
